# Copy to .env and fill in. Never commit .env.

# Deployment kind. "dev" (the default) and "test" allow the placeholder JWT_SECRET below so
# local development needs no configuration at all. Any other value — including a typo — is
# treated as production and refuses to start without a real secret, so this fails safe.
APP_ENV=dev

# External services
# OTP host root (self-hosted OTP2); the client appends /otp/gtfs/v1 (GTFS GraphQL).
OTP_BASE_URL=http://localhost:8080
BUIENRADAR_URL=https://gpsgadget.buienradar.nl/data/raintext
# Nominatim geocoding (place name -> coords). Policy requires an identifying User-Agent.
NOMINATIM_URL=https://nominatim.openstreetmap.org/search
GEOCODER_USER_AGENT=fiets-of-ov/0.1 (https://github.com/fiets-of-ov)
# Overall deadline (seconds) for the bike-snapping fallback's OTP probe fan-out.
SNAP_TIMEOUT_SECONDS=8.0

# Infra (defaults match docker compose)
DATABASE_URL=postgresql+asyncpg://fiets:fiets@db:5432/fiets
REDIS_URL=redis://redis:6379/0

# Auth (JWT). JWT_SECRET MUST be overridden with a strong random value (>=32 bytes) in
# production, e.g. `openssl rand -hex 32`. With APP_ENV set to anything but dev/test the app
# refuses to start on this placeholder (or on a secret under 32 bytes).
JWT_SECRET=dev-insecure-change-me-override-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Browser origins allowed to call the API cross-origin. Comma-separated (a JSON array works
# too). The default is the Vite dev server; "*" is rejected, since the API sends
# credentials-capable CORS headers and a wildcard would reflect any caller's origin.
CORS_ALLOW_ORIGINS=http://localhost:5173

# Background rain notifications (Phase 6, ARQ worker)
# Lead time before a trip's departure that we look ahead when deciding to notify (minutes).
NOTIFY_LEAD_MINUTES=15
# How often the worker sweeps for due trip alerts (seconds; 300 = every 5 min).
NOTIFY_SCHEDULER_SECONDS=300

# App
LOG_LEVEL=INFO
