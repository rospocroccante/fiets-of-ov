# Copy to .env and fill in. Never commit .env.

# External services
OTP_BASE_URL=https://otp.plannerstack.io/otp/routers/default
BUIENRADAR_URL=https://gpsgadget.buienradar.nl/data/raintext

# Infra (defaults match docker compose)
DATABASE_URL=postgresql+asyncpg://fiets:fiets@db:5432/fiets
REDIS_URL=redis://redis:6379/0

# App
LOG_LEVEL=INFO
